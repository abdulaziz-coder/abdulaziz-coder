{
  "name": "bm-international-school",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "BM International School React and FastAPI application",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "dev:all": "python scripts/dev.py",
    "setup:services": "python scripts/setup_services.py",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "framer-motion": "^12.23.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "~4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "~4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
